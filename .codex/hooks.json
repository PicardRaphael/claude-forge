{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session-state-reset.py\"",
            "commandWindows": "py .codex/hooks/session-state-reset.py",
            "timeout": 5,
            "statusMessage": "Resetting ephemeral session state"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/memory-health.py\"",
            "commandWindows": "py .codex/hooks/memory-health.py",
            "timeout": 5,
            "statusMessage": "Checking temporary-memory lifecycle"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/codex-apply-patch-guard.py\"",
            "commandWindows": "py .codex/hooks/codex-apply-patch-guard.py",
            "timeout": 10,
            "statusMessage": "Checking apply_patch policy"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/pre-bash-guards.py\"",
            "commandWindows": "py .codex/hooks/pre-bash-guards.py",
            "timeout": 10,
            "statusMessage": "Checking shell/read policy"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/pre-write-guards.py\"",
            "commandWindows": "py .codex/hooks/pre-write-guards.py",
            "timeout": 10,
            "statusMessage": "Checking write policy"
          }
        ]
      },
      {
        "matcher": "mcp__forge-brain__append_note|mcp__forge-brain__insert_section|mcp__forge-brain__read_section|mcp__forge-brain__update_note|mcp__forge-brain__delete_note|mcp__forge-brain__move_note|mcp__forge-brain__update_property|mcp__forge-brain__bulk_update_property",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/mcp-alias-guard.py\"",
            "commandWindows": "py .codex/hooks/mcp-alias-guard.py",
            "timeout": 10,
            "statusMessage": "Checking forge-brain alias"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session-health.py\"",
            "commandWindows": "py .codex/hooks/session-health.py",
            "timeout": 5,
            "statusMessage": "Checking session health"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/skill-activation.py\"",
            "commandWindows": "py .codex/hooks/skill-activation.py",
            "timeout": 3,
            "statusMessage": "Checking skill recommendations"
          },
          {
            "type": "command",
            "command": "python3 .codex/hooks/memory-recall.py",
            "commandWindows": "py .codex/hooks/memory-recall.py",
            "timeout": 3,
            "statusMessage": "Checking relevant project memories"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/metrics-tracker.py\"",
            "commandWindows": "py .codex/hooks/metrics-tracker.py",
            "timeout": 2,
            "statusMessage": "Recording tool metrics"
          }
        ]
      }
    ]
  }
}
