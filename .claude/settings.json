{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(git -C *)",
      "Bash(ls *)",
      "Bash(taskkill *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rundll32 user32.dll,MessageBeep",
            "timeout": 2
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"C:/Users/raphael.picard_neote/Documents/claude-forge/.claude/hooks/learning-reminder.py\"",
            "timeout": 10,
            "once": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"C:/Users/raphael.picard_neote/Documents/claude-forge/.claude/hooks/security-guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"C:/Users/raphael.picard_neote/Documents/claude-forge/.claude/hooks/delegate-guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"C:/Users/raphael.picard_neote/Documents/claude-forge/.claude/hooks/vault-query-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Grep|Glob|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"C:/Users/raphael.picard_neote/Documents/claude-forge/.claude/hooks/vault-query-tracker.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"C:/Users/raphael.picard_neote/Documents/claude-forge/.claude/hooks/devil-advocate-tracker.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"C:/Users/raphael.picard_neote/Documents/claude-forge/.claude/hooks/devil-advocate-guard.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"C:/Users/raphael.picard_neote/Documents/claude-forge/.claude/hooks/reasoning-cache-reminder.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"C:/Users/raphael.picard_neote/Documents/claude-forge/.claude/hooks/session-health.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"C:/Users/raphael.picard_neote/Documents/claude-forge/.claude/hooks/session-reminder.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {}
}
