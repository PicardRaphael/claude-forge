{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(ls *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -c \"[console]::beep(800,300)\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"C:/Users/raphael.picard_neote/Documents/claude-forge/.claude/hooks/security-guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"C:/Users/raphael.picard_neote/Documents/claude-forge/.claude/hooks/delegate-guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"C:/Users/raphael.picard_neote/Documents/claude-forge/.claude/hooks/session-reminder.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {}
}
